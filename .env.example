# ==========================================
# Grant Application Completeness Assistant
# Environment Variables Configuration
# ==========================================

PORT=3001
NODE_ENV=development

# Optional LLM API Keys (If left empty, system uses intelligent built-in semantic analyzer)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Database configuration (Defaults to local SQLite)
DATABASE_URL=file:./grant_assistant.sqlite
